# Copy to .env (never commit .env)
GRIMMORY_URL=http://192.168.0.9:6060          # how the site reaches Grimmory
GRIMMORY_PUBLIC_URL=https://grimmory.krisboho.com   # how browsers reach Grimmory (Read online)
SESSION_SECRET=change-me-to-a-long-random-string
KINDLE_SHELF_NAME=Kindle
SECURE_COOKIES=true                            # true behind HTTPS (tunnel); false for plain http on the LAN
SHELFMARK_URL=http://192.168.0.9:8084            # Shelfmark, server-side only
SHELFMARK_API_KEY=                                # Shelfmark's SHELFMARK_API_KEY (root-equivalent, keep secret)
DATA_DIR=/data                                    # SQLite for download history (mount a volume here)
ALERT_WEBHOOK_URL=                                # optional: POST {"title","message","priority"} here when every mirror is down (HA webhook, ntfy, ...)
HEALTH_INTERVAL_MIN=15                            # how often to test mirrors and services
ALERT_AFTER_MIN=30                                # alert when all mirrors have failed this long
GRIMMORY_URL_MAP=                                 # optional per-host override: sitehost=grimmory-url,otherhost=url
