# Copy to .env (never commit .env)
GRIMMORY_URL=http://192.168.0.9:6060          # how the site reaches Grimmory
GRIMMORY_PUBLIC_URL=https://booklore.krisboho.com   # how browsers reach Grimmory (Read online)
SESSION_SECRET=change-me-to-a-long-random-string
KINDLE_SHELF_NAME=Kindle
SECURE_COOKIES=true                            # true behind HTTPS (tunnel); false for plain http on the LAN
